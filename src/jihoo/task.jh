// Architecture callbacks keep task ownership independent of CPU entry code.
import std.mem
import space
import file_table
import shared
import kernel_sync
import cpu_state

extern fn kaguya_cpu_state() -> *cpu_state.PerCpu
extern fn kaguya_online_cpus() -> u64
extern fn kaguya_kick_cpu(cpu: u64)
extern fn kaguya_kernel_root() -> u64
extern fn kaguya_prepare_switch(cpu: u64, stack: u64, user_stack: u64, user_gs: u64, root: u64)
extern fn kaguya_context_switch(old: *u64, next: u64, handoff: *u64, encoded: u64, retired: *u64, bottom: u64)
extern fn kaguya_user_trampoline_address() -> u64
extern fn kaguya_kernel_return_address() -> u64
extern fn kaguya_runtime_alloc(size: u64, alignment: u64) -> *u8
extern fn kaguya_runtime_free(pointer: *u8)
extern fn jihoo_read_msr(msr: u32) -> u64

const NONE: u64 = 0xffffffffffffffff
const QUANTUM: u32 = 5

#[derive(Eq)]
pub enum Status { Ready, Claimed, SwitchingOut, Running, Sleeping, Waiting, Zombie }

struct Task {
    id: u64
    stack: u64
    status: Status
    affinity: u64
    pinned: u64
    kernel_bottom: u64
    kernel_top: u64
    user_gs: u64
    user_rsp: u64
    exit_code: u64
    wake_tick: u64
    waiting_for: u64
    address_space: Option(space.AddressSpace)
    files: Option(shared.Shared(file_table.FileTable))
}

struct Event { key: u64, generation: u64 }

struct Scheduler {
    tasks: Vec(Box(Task))
    events: Vec(Event)
    queues: Vec(kernel_sync.Spinlock(Vec(u64)))
}

static SCHEDULER: *kernel_sync.Spinlock(Scheduler) = null
static READY: bool = false
static NEXT_ID: u64 = 1
static TICKS: u64 = 0
static SWITCHES: u64 = 0
static CURRENT: [u64; 64] = [NONE; 64]
static HANDOFF: [u64; 64] = [0; 64]
static RETIRED: [u64; 64] = [0; 64]

pub fn ready() -> bool { unsafe { atomic_load(&READY) } }
pub fn clock() -> u64 { unsafe { atomic_load(&TICKS) } }
pub fn switches() -> u64 { unsafe { atomic_load(&SWITCHES) } }

pub fn init() {
    if ready() { panic("scheduler already initialized") }
    var queues = Vec(kernel_sync.Spinlock(Vec(u64))).with_capacity(64)
    for _ in 0..64 { queues.push(kernel_sync.Spinlock.new(Vec(u64).new())) }
    var tasks = Vec(Box(Task)).new()
    tasks.push(Box.new(Task { id: 0, stack: 0, status: Status.Running, affinity: 0, pinned: 0,
        kernel_bottom: 0, kernel_top: 0, user_gs: 0, user_rsp: 0, exit_code: 0, wake_tick: 0,
        waiting_for: NONE, address_space: None, files: None }))
    unsafe {
        let pointer = mem.alloc(kernel_sync.Spinlock(Scheduler), 1)
        write(pointer, kernel_sync.Spinlock.new(Scheduler { tasks: tasks, events: Vec(Event).new(), queues: queues }))
        SCHEDULER = pointer
        let local = kaguya_cpu_state()
        local.current_task = 0
        atomic_store(&CURRENT[0], 0)
        atomic_store(&READY, true)
    }
}

pub fn enter_idle() {
    unsafe {
        var guard = (*SCHEDULER).lock()
        let local = kaguya_cpu_state()
        if local.current_task != NONE {
            guard.deref_mut().tasks[local.current_task as i64].status = Status.Zombie
        }
        local.current_task = NONE
        local.idle_stack = 0
        local.ticks_left = 0
        local.need_reschedule = false
        atomic_store(&CURRENT[local.cpu_index as i64], NONE)
    }
}

fn target(scheduler: Scheduler) -> u64 {
    let count = min(unsafe { kaguya_online_cpus() }, 64)
    var cpu: u64 = 1
    while cpu < count {
        if unsafe { atomic_load(&CURRENT[cpu as i64]) } == NONE && scheduler.queues[cpu as i64].lock().is_empty() {
            return cpu
        }
        cpu += 1
    }
    0
}

fn enqueue(scheduler: Scheduler, cpu: u64, index: u64) {
    scheduler.queues[cpu as i64].lock().deref_mut().push(index)
}

pub fn add_user(entry: u64, user_rsp: u64, args: u64, count: u64,
                 address_space: space.AddressSpace, files: shared.Shared(file_table.FileTable)) -> u64 {
    unsafe {
        var guard = (*SCHEDULER).lock()
        let id = atomic_add(&NEXT_ID, 1)
        let bottom = kaguya_runtime_alloc(16384, 16)
        if bottom == null { return NONE }
        let top = bottom as u64 + 16384
        let saved = (top - 112) as *u64
        mem_fill(saved as *u8, 0, 112)
        saved[0] = count
        saved[1] = args
        saved[8] = kaguya_user_trampoline_address()
        saved[9] = entry
        saved[10] = 0x23
        saved[11] = 0x202
        saved[12] = user_rsp
        saved[13] = 0x1b
        let cpu: u64 = if id == 1 { 0 } else { target(guard.deref()) }
        let index = guard.tasks.len() as u64
        guard.deref_mut().tasks.push(Box.new(Task { id: id, stack: saved as u64,
            status: Status.Ready, affinity: cpu, pinned: if id == 1 { 0 } else { NONE },
            kernel_bottom: bottom as u64, kernel_top: top, user_gs: 0, user_rsp: user_rsp,
            exit_code: 0, wake_tick: 0, waiting_for: NONE,
            address_space: Some(address_space.clone()), files: Some(files.clone()) }))
        enqueue(guard.deref(), cpu, index)
        if cpu != 0 { kaguya_kick_cpu(cpu) }
        id
    }
}

pub fn add_kernel(entry: u64, bottom: u64, bytes: u64) -> u64 {
    unsafe {
        var guard = (*SCHEDULER).lock()
        let id = atomic_add(&NEXT_ID, 1)
        let top = (bottom + bytes) & !15
        let saved = (top - 112) as *u64
        mem_fill(saved as *u8, 0, 112)
        saved[8] = entry
        saved[9] = kaguya_kernel_return_address()
        let cpu = target(guard.deref())
        let index = guard.tasks.len() as u64
        guard.deref_mut().tasks.push(Box.new(Task { id: id, stack: saved as u64,
            status: Status.Ready, affinity: cpu, pinned: NONE, kernel_bottom: bottom, kernel_top: top,
            user_gs: 0, user_rsp: 0, exit_code: 0, wake_tick: 0, waiting_for: NONE,
            address_space: None, files: None }))
        enqueue(guard.deref(), cpu, index)
        if cpu != 0 { kaguya_kick_cpu(cpu) }
        id
    }
}

fn claim_local(inout scheduler: Scheduler, cpu: u64) -> u64 {
    var queue = scheduler.queues[cpu as i64].lock()
    while !queue.is_empty() {
        let index = queue.deref_mut().remove(0)
        if index >= scheduler.tasks.len() as u64 { continue }
        if scheduler.tasks[index as i64].status == Status.Ready {
            scheduler.tasks[index as i64].status = Status.Claimed
            return index
        }
    }
    NONE
}

fn steal(inout scheduler: Scheduler, cpu: u64) -> u64 {
    let count = min(unsafe { kaguya_online_cpus() }, 64)
    var victim = NONE
    var longest: i64 = 1
    var other: u64 = 0
    while other < count {
        if other != cpu {
            let length = scheduler.queues[other as i64].lock().len()
            if length > longest { victim = other; longest = length }
        }
        other += 1
    }
    if victim == NONE { return NONE }
    var queue = scheduler.queues[victim as i64].lock()
    while queue.len() > 1 {
        var position = queue.len()
        while position > 0 {
            position -= 1
            let index = queue.deref()[position]
            if index < scheduler.tasks.len() as u64 && scheduler.tasks[index as i64].status == Status.Ready &&
                scheduler.tasks[index as i64].pinned == NONE {
                queue.deref_mut().remove(position)
                scheduler.tasks[index as i64].status = Status.Claimed
                scheduler.tasks[index as i64].affinity = cpu
                return index
            }
        }
        break
    }
    NONE
}

fn published(index: u64) -> bool {
    unsafe { for cpu in 0..64 { if atomic_load(&CURRENT[cpu]) == index { return true } } }
    false
}

fn maintenance(inout scheduler: Scheduler) {
    let now = clock()
    for i in 0..scheduler.tasks.len() {
        if (scheduler.tasks[i].status == Status.Sleeping ||
             (scheduler.tasks[i].status == Status.Waiting && scheduler.tasks[i].wake_tick != 0)) &&
            scheduler.tasks[i].wake_tick <= now {
            scheduler.tasks[i].status = Status.Ready
            scheduler.tasks[i].waiting_for = NONE
            scheduler.tasks[i].wake_tick = 0
            let pinned = scheduler.tasks[i].pinned
            let cpu = min(if pinned != NONE { pinned } else { scheduler.tasks[i].affinity }, 63)
            enqueue(scheduler, cpu, i as u64)
        }
        if scheduler.tasks[i].status != Status.Zombie || scheduler.tasks[i].kernel_bottom == 0 || published(i as u64) { continue }
        let bottom = scheduler.tasks[i].kernel_bottom
        var acknowledged = false
        unsafe {
            for slot in 0..64 { if atomic_cas(&RETIRED[slot], bottom, 0) { acknowledged = true; break } }
            if acknowledged {
                kaguya_runtime_free(bottom as *u8)
                scheduler.tasks[i].address_space = None
                scheduler.tasks[i].kernel_bottom = 0
                scheduler.tasks[i].kernel_top = 0
            }
        }
    }
}

pub fn schedule() {
    if !ready() { return }
    unsafe {
        var guard = (*SCHEDULER).lock()
        let local = kaguya_cpu_state()
        let cpu = local.cpu_index as u64
        let current = local.current_task
        if cpu == 0 { maintenance(&guard.deref_mut()) }
        let finished = atomic_swap(&HANDOFF[cpu as i64], 0)
        if finished != 0 && finished <= guard.tasks.len() as u64 &&
            guard.tasks[(finished - 1) as i64].status == Status.SwitchingOut {
            guard.deref_mut().tasks[(finished - 1) as i64].status = Status.Ready
            guard.deref_mut().tasks[(finished - 1) as i64].affinity = cpu
            enqueue(guard.deref(), cpu, finished - 1)
        }
        var next = claim_local(&guard.deref_mut(), cpu)
        if next == NONE { next = steal(&guard.deref_mut(), cpu) }
        if next == NONE {
            if current == NONE || local.idle_stack == 0 { return }
            let state = guard.tasks[current as i64].status
            if state != Status.Zombie && state != Status.Sleeping && state != Status.Waiting { return }
            let old = &guard.deref_mut().tasks[current as i64].stack
            let bottom = if state == Status.Zombie { guard.tasks[current as i64].kernel_bottom } else { 0 }
            let idle = local.idle_stack
            guard.deref_mut().tasks[current as i64].user_rsp = local.user_stack
            guard.deref_mut().tasks[current as i64].user_gs = jihoo_read_msr(0xc0000102)
            local.current_task = NONE
            local.user_stack = 0
            local.ticks_left = 0
            local.need_reschedule = false
            atomic_store(&CURRENT[cpu as i64], NONE)
            drop(guard)
            kaguya_prepare_switch(cpu, 0, 0, 0, kaguya_kernel_root())
            atomic_add(&SWITCHES, 1)
            kaguya_context_switch(old, idle, &HANDOFF[cpu as i64], 0, &RETIRED[0], bottom)
            return
        }
        var encoded: u64 = 0
        if current != NONE && guard.tasks[current as i64].status == Status.Running {
            guard.deref_mut().tasks[current as i64].status = Status.SwitchingOut
            encoded = current + 1
        }
        let pinned = guard.tasks[next as i64].pinned
        if pinned != NONE && pinned != cpu {
            guard.deref_mut().tasks[next as i64].status = Status.Ready
            enqueue(guard.deref(), min(pinned, 63), next)
            return
        }
        let old = if current == NONE { &local.idle_stack } else { &guard.deref_mut().tasks[current as i64].stack }
        var bottom: u64 = 0
        if current != NONE {
            guard.deref_mut().tasks[current as i64].user_rsp = local.user_stack
            guard.deref_mut().tasks[current as i64].user_gs = jihoo_read_msr(0xc0000102)
            if guard.tasks[current as i64].status == Status.Zombie { bottom = guard.tasks[current as i64].kernel_bottom }
        }
        guard.deref_mut().tasks[next as i64].status = Status.Running
        guard.deref_mut().tasks[next as i64].affinity = cpu
        guard.deref_mut().tasks[next as i64].wake_tick = 0
        local.current_task = next
        local.ticks_left = QUANTUM
        local.need_reschedule = false
        atomic_store(&CURRENT[cpu as i64], next)
        let stack = guard.tasks[next as i64].stack
        let kernel_top = guard.tasks[next as i64].kernel_top
        let user_rsp = guard.tasks[next as i64].user_rsp
        let gs = guard.tasks[next as i64].user_gs
        let root = match guard.tasks[next as i64].address_space {
            Some(address_space) => address_space.root()
            None => kaguya_kernel_root()
        }
        drop(guard)
        kaguya_prepare_switch(cpu, kernel_top, user_rsp, gs, root)
        atomic_add(&SWITCHES, 1)
        kaguya_context_switch(old, stack, &HANDOFF[cpu as i64], encoded, &RETIRED[0], bottom)
    }
}

pub fn current_space() -> Option(space.AddressSpace) {
    if !ready() { return None }
    unsafe {
        let guard = (*SCHEDULER).lock()
        let index = kaguya_cpu_state().current_task
        if index == NONE { return None }
        match guard.tasks[index as i64].address_space { Some(value) => Some(value.clone()), None => None }
    }
}

pub fn current_files() -> Option(shared.Shared(file_table.FileTable)) {
    if !ready() { return None }
    unsafe {
        let guard = (*SCHEDULER).lock()
        let index = kaguya_cpu_state().current_task
        if index == NONE { return None }
        match guard.tasks[index as i64].files { Some(value) => Some(value.clone()), None => None }
    }
}

pub fn exit(code: u64) -> never {
    unsafe {
        let files = {
            var guard = (*SCHEDULER).lock()
            let index = kaguya_cpu_state().current_task
            if index == NONE { panic("idle task cannot exit") }
            mem.replace(&guard.deref_mut().tasks[index as i64].files, None)
        }
        drop(files)
        {
            var guard = (*SCHEDULER).lock()
            let index = kaguya_cpu_state().current_task
            guard.deref_mut().tasks[index as i64].status = Status.Zombie
            guard.deref_mut().tasks[index as i64].exit_code = code
            let id = guard.tasks[index as i64].id
            for i in 0..guard.tasks.len() {
                if guard.tasks[i].status == Status.Waiting && guard.tasks[i].waiting_for == id {
                    guard.deref_mut().tasks[i].status = Status.Ready
                    guard.deref_mut().tasks[i].waiting_for = NONE
                    enqueue(guard.deref(), min(guard.tasks[i].affinity, 63), i as u64)
                }
            }
        }
        schedule()
        panic("exited task resumed")
    }
}

pub fn status(id: u64) -> u64 {
    if !ready() { return 3 }
    unsafe {
        let guard = (*SCHEDULER).lock()
        for i in 0..guard.tasks.len() {
            if guard.tasks[i].id == id {
                return match guard.tasks[i].status {
                    Status.Ready | Status.Claimed | Status.SwitchingOut => 0
                    Status.Running => 1
                    Status.Zombie => 2
                    Status.Sleeping => 3
                    Status.Waiting => 4
                }
            }
        }
    }
    3
}

pub fn exit_code(id: u64) -> u64 {
    unsafe {
        let guard = (*SCHEDULER).lock()
        for i in 0..guard.tasks.len() { if guard.tasks[i].id == id { return guard.tasks[i].exit_code } }
    }
    0
}

pub fn wait_task(id: u64) -> u64 {
    unsafe {
        {
            var guard = (*SCHEDULER).lock()
            var target = NONE
            for i in 0..guard.tasks.len() { if guard.tasks[i].id == id { target = i as u64; break } }
            if target == NONE { return NONE }
            if guard.tasks[target as i64].status == Status.Zombie { return guard.tasks[target as i64].exit_code }
            let current = kaguya_cpu_state().current_task
            if current == NONE || current == target { return NONE }
            guard.deref_mut().tasks[current as i64].status = Status.Waiting
            guard.deref_mut().tasks[current as i64].waiting_for = id
        }
        schedule()
        exit_code(id)
    }
}

fn generation(scheduler: Scheduler, key: u64) -> u64 {
    for i in 0..scheduler.events.len() { if scheduler.events[i].key == key { return scheduler.events[i].generation } }
    0
}

pub export fn kaguya_event_generation(key: u64) -> u64 {
    if !ready() { return 0 }
    unsafe { let guard = (*SCHEDULER).lock(); generation(guard.deref(), key) }
}

pub export fn kaguya_wait_event(key: u64, deadline: u64, observed: u64) {
    if !ready() { return }
    unsafe {
        {
            var guard = (*SCHEDULER).lock()
            if generation(guard.deref(), key) != observed { return }
            let current = kaguya_cpu_state().current_task
            if current == NONE { return }
            guard.deref_mut().tasks[current as i64].waiting_for = key
            guard.deref_mut().tasks[current as i64].wake_tick = deadline
            guard.deref_mut().tasks[current as i64].status = Status.Waiting
        }
        schedule()
    }
}

pub export fn kaguya_wake_event(key: u64) {
    if !ready() { return }
    unsafe {
        var guard = (*SCHEDULER).lock()
        var found = false
        for i in 0..guard.events.len() {
            if guard.events[i].key == key {
                let old = guard.events[i].generation
                guard.deref_mut().events[i].generation = if old == NONE { 0 } else { old + 1 }
                found = true
                break
            }
        }
        if !found { guard.deref_mut().events.push(Event { key: key, generation: 1 }) }
        for i in 0..guard.tasks.len() {
            if guard.tasks[i].status == Status.Waiting && guard.tasks[i].waiting_for == key {
                guard.deref_mut().tasks[i].waiting_for = NONE
                guard.deref_mut().tasks[i].wake_tick = 0
                if published(i as u64) { guard.deref_mut().tasks[i].status = Status.Running; continue }
                guard.deref_mut().tasks[i].status = Status.Ready
                let cpu = min(guard.tasks[i].affinity, 63)
                enqueue(guard.deref(), cpu, i as u64)
                if cpu != 0 { kaguya_kick_cpu(cpu) }
            }
        }
    }
}

pub export fn kaguya_forget_event(key: u64) {
    if !ready() { return }
    unsafe {
        var guard = (*SCHEDULER).lock()
        for i in 0..guard.events.len() {
            if guard.events[i].key == key { guard.deref_mut().events.remove(i); break }
        }
    }
}

pub fn sleep(milliseconds: u64) {
    if milliseconds == 0 { schedule(); return }
    let rounded = if milliseconds > NONE - 9 { NONE } else { milliseconds + 9 }
    let ticks = max(rounded / 10, 1)
    let now = clock()
    let deadline = if ticks > NONE - now { NONE } else { now + ticks }
    unsafe {
        {
            var guard = (*SCHEDULER).lock()
            let current = kaguya_cpu_state().current_task
            if current != NONE {
                guard.deref_mut().tasks[current as i64].wake_tick = deadline
                guard.deref_mut().tasks[current as i64].status = Status.Sleeping
            }
        }
        schedule()
    }
}

pub export fn kaguya_scheduler_clock_tick() { unsafe { atomic_add(&TICKS, 1) } }

pub export fn kaguya_scheduler_interrupt(user: bool) {
    if !ready() || !user { return }
    unsafe {
        let local = kaguya_cpu_state()
        if local.current_task == NONE { return }
        if local.ticks_left > 0 { local.ticks_left -= 1 }
        if local.ticks_left == 0 { local.need_reschedule = true }
        if local.need_reschedule { local.need_reschedule = false; schedule() }
    }
}
