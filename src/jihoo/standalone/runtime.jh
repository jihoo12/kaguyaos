import heap
import io
import console
import framebuffer
import sync
import display

extern fn jihoo_pause()
extern fn jihoo_halt() -> never

static LOCK: u8 = 0
static LIVE: u64 = 0
static SCREEN_LOCK: u8 = 0
static SCREEN_READY: bool = false
static SCREEN: console.Console = zeroed(console.Console)

fn acquire() -> u64 {
    unsafe { sync.jihoo_lock_acquire(&LOCK) }
}

fn release(flags: u64) {
    unsafe {
        sync.jihoo_lock_release(&LOCK, flags & 0x200 != 0)
    }
}

pub export fn kaguya_runtime_alloc(size: u64, alignment: u64) -> *u8 {
    let flags = acquire()
    let pointer = heap.jihoo_heap_alloc(if size == 0 { 1 } else { size }, alignment)
    unsafe { if pointer != null { LIVE += 1 } }
    release(flags)
    pointer
}

pub export fn kaguya_runtime_realloc(pointer: *u8, size: u64, alignment: u64) -> *u8 {
    if pointer == null { return kaguya_runtime_alloc(size, alignment) }
    let flags = acquire()
    let next = heap.jihoo_heap_realloc(pointer, if size == 0 { 1 } else { size }, alignment)
    release(flags)
    next
}

pub export fn kaguya_runtime_free(pointer: *u8) {
    if pointer == null { return }
    let flags = acquire()
    heap.jihoo_heap_free(pointer)
    unsafe { LIVE -= 1 }
    release(flags)
}

pub fn live_allocations() -> u64 { unsafe { LIVE } }

pub fn clear() {
    unsafe {
        let flags = sync.jihoo_lock_acquire(&SCREEN_LOCK)
        if SCREEN_READY {
            console.jihoo_console_clear(&SCREEN, 0)
            display.mark(SCREEN.origin_x, SCREEN.origin_y, SCREEN.width, SCREEN.height)
            display.present()
        }
        sync.jihoo_lock_release(&SCREEN_LOCK, flags & 0x200 != 0)
    }
}

pub fn init_display(base: u64, stride: u64, width: u64, height: u64, format: u32) {
    match display.init(base, stride, width, height, format) {
        Some(surface) => unsafe {
            let flags = sync.jihoo_lock_acquire(&SCREEN_LOCK)
            console.jihoo_console_init(&SCREEN, &surface, 1)
            let area = display.desktop()
            console.jihoo_console_viewport(&SCREEN, area.0, area.1, area.2, area.3)
            display.present()
            sync.jihoo_lock_release(&SCREEN_LOCK, flags & 0x200 != 0)
        }
        None => serial("display: unsupported backbuffer size; keeping direct GOP console\n")
    }
}

pub fn cell(row: u64, column: u64, character: u32, foreground: u32, background: u32) {
    unsafe {
        let flags = sync.jihoo_lock_acquire(&SCREEN_LOCK)
        if SCREEN_READY {
            console.jihoo_console_cell(&SCREEN, row, column, character, foreground, background)
            display.mark(SCREEN.origin_x, SCREEN.origin_y, SCREEN.width, SCREEN.height)
            display.present()
        }
        sync.jihoo_lock_release(&SCREEN_LOCK, flags & 0x200 != 0)
    }
}

pub fn region(row: u64, column: u64, cells: *console.Cell, length: u64, width: u64) {
    unsafe {
        let flags = sync.jihoo_lock_acquire(&SCREEN_LOCK)
        if SCREEN_READY {
            console.jihoo_console_region(&SCREEN, row, column, cells, length, width)
            display.mark(SCREEN.origin_x, SCREEN.origin_y, SCREEN.width, SCREEN.height)
            display.present()
        }
        sync.jihoo_lock_release(&SCREEN_LOCK, flags & 0x200 != 0)
    }
}

pub fn init_console(base: *u32, stride: u64, width: u64, height: u64, format: u32) {
    var surface = framebuffer.Framebuffer { base: base, stride: stride, width: width, height: height }
    unsafe {
        let flags = sync.jihoo_lock_acquire(&SCREEN_LOCK)
        console.jihoo_console_init(&SCREEN, &surface, format)
        console.jihoo_console_clear(&SCREEN, 0)
        SCREEN_READY = true
        sync.jihoo_lock_release(&SCREEN_LOCK, flags & 0x200 != 0)
    }
}

pub fn output(text: str) {
    serial(text)
    unsafe {
        let flags = sync.jihoo_lock_acquire(&SCREEN_LOCK)
        if SCREEN_READY {
            console.jihoo_console_write(&SCREEN, text.ptr, text.len as u64)
            display.mark(SCREEN.origin_x, SCREEN.origin_y, SCREEN.width, SCREEN.height)
            display.present()
        }
        sync.jihoo_lock_release(&SCREEN_LOCK, flags & 0x200 != 0)
    }
}

pub fn serial(text: str) {
    for byte in text {
        unsafe {
            for _ in 0..100000 {
                if io.jihoo_inb(0x3fd) & 0x20 != 0 { break }
                jihoo_pause()
            }
            io.jihoo_outb(0x3f8, byte)
        }
    }
}

export fn kaguya_device_log(bytes: *u8, length: u64) { unsafe { output(make_str(bytes, length as i64)) } }
export fn kaguya_graphics_log(bytes: *u8, length: u64) { unsafe { serial(make_str(bytes, length as i64)) } }

pub export fn kaguya_runtime_write(fd: i32, bytes: *u8, length: u64) -> i64 {
    if fd != 1 && fd != 2 { return -1 }
    output(unsafe { make_str(bytes, length as i64) })
    length as i64
}

export fn kaguya_kernel_panic(bytes: *u8, length: u64) -> never {
    serial("jihoo kernel panic: ")
    serial(unsafe { make_str(bytes, length as i64) })
    serial("\n")
    unsafe { jihoo_halt() }
}
