extern fn jihoo_inl(port: u16) -> u32
extern fn jihoo_outl(port: u16, value: u32)

struct Device {
    bus: u8
    device: u8
    function: u8
    vendor_id: u16
    device_id: u16
    bar0: u32
    bar1: u32
    interrupt_line: u8
    interrupt_pin: u8
}

fn config_address(bus: u8, device: u8, function: u8, offset: u8) -> u32 {
    (bus as u32 << 16) | (device as u32 << 11) | (function as u32 << 8) |
        (offset as u32 & 0xfc) | 0x80000000
}

export fn jihoo_pci_read32(bus: u8, device: u8, function: u8, offset: u8) -> u32 {
    unsafe {
        jihoo_outl(0xcf8, config_address(bus, device, function, offset))
        jihoo_inl(0xcfc)
    }
}

export fn jihoo_pci_read16(bus: u8, device: u8, function: u8, offset: u8) -> u16 {
    let value = jihoo_pci_read32(bus, device, function, offset)
    (value >> ((offset & 2) * 8)) as u16
}

export fn jihoo_pci_read8(bus: u8, device: u8, function: u8, offset: u8) -> u8 {
    let value = jihoo_pci_read32(bus, device, function, offset)
    (value >> ((offset & 3) * 8)) as u8
}

export fn jihoo_pci_write32(bus: u8, device: u8, function: u8, offset: u8, value: u32) {
    unsafe {
        jihoo_outl(0xcf8, config_address(bus, device, function, offset))
        jihoo_outl(0xcfc, value)
    }
}

export fn jihoo_pci_bar0(bar0: u32, bar1: u32) -> u64 {
    var base = bar0 as u64 & 0xfffffff0
    if (bar0 >> 1) & 3 == 2 { base |= bar1 as u64 << 32 }
    base
}

export fn jihoo_pci_scan(visit: fnptr(u8, u8, u8)) {
    for bus in 0..256 {
        for device in 0..32 {
            if jihoo_pci_read16(bus as u8, device as u8, 0, 0) == 0xffff { continue }
            unsafe { visit(bus as u8, device as u8, 0) }
            if jihoo_pci_read8(bus as u8, device as u8, 0, 0xe) & 0x80 != 0 {
                for function in 1..8 {
                    if jihoo_pci_read16(bus as u8, device as u8, function as u8, 0) != 0xffff {
                        unsafe { visit(bus as u8, device as u8, function as u8) }
                    }
                }
            }
        }
    }
}

export fn jihoo_pci_find_xhci(index: u64, output: *Device) -> bool {
    var found: u64 = 0
    for bus in 0..256 {
        for device in 0..32 {
            for function in 0..8 {
                let b = bus as u8
                let d = device as u8
                let f = function as u8
                let vendor_id = jihoo_pci_read16(b, d, f, 0)
                if vendor_id == 0xffff { continue }
                if jihoo_pci_read8(b, d, f, 0xb) != 0x0c ||
                    jihoo_pci_read8(b, d, f, 0xa) != 3 ||
                    jihoo_pci_read8(b, d, f, 9) != 0x30 { continue }
                if found == index {
                    unsafe {
                        *output = Device {
                            bus: b, device: d, function: f, vendor_id,
                            device_id: jihoo_pci_read16(b, d, f, 2),
                            bar0: jihoo_pci_read32(b, d, f, 0x10),
                            bar1: jihoo_pci_read32(b, d, f, 0x14),
                            interrupt_line: jihoo_pci_read8(b, d, f, 0x3c),
                            interrupt_pin: jihoo_pci_read8(b, d, f, 0x3d),
                        }
                    }
                    return true
                }
                found += 1
            }
        }
    }
    false
}
