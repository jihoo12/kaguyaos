import std.mem

struct Inner(T: type) {
    references: u64
    weak: u64
    value: T
}

pub struct Shared(T: type) {
    pointer: *Inner(T)
}

pub struct Weak(T: type) {
    pointer: *Inner(T)
}

impl(T: type) Shared(T) {
    pub fn new(sink value: T) -> Shared(T) {
        unsafe {
            let pointer = mem.alloc(Inner(T), 1)
            write(pointer, Inner(T) { references: 1, weak: 1, value: value })
            Shared(T) { pointer: pointer }
        }
    }

    pub fn deref(self) -> ref T { unsafe { self.pointer.value } }

    pub fn address(self) -> u64 { unsafe { &self.pointer.value as u64 } }

    pub fn downgrade(self) -> Weak(T) {
        unsafe {
            if atomic_add(&self.pointer.weak, 1) >= 0x7fffffffffffffff { panic("weak reference overflow") }
            Weak(T) { pointer: self.pointer }
        }
    }
}

impl(T: type) Clone for Shared(T) {
    fn clone(self) -> Shared(T) {
        unsafe {
            if atomic_add(&self.pointer.references, 1) >= 0x7fffffffffffffff {
                panic("shared reference overflow")
            }
            Shared(T) { pointer: self.pointer }
        }
    }
}

impl(T: type) Drop for Shared(T) {
    fn drop(inout self) {
        unsafe {
            if atomic_sub(&self.pointer.references, 1) == 1 {
                mem.drop_at(T, &self.pointer.value)
                if atomic_sub(&self.pointer.weak, 1) == 1 { mem.dealloc(Inner(T), self.pointer, 1) }
            }
        }
    }
}

impl(T: type) Weak(T) {
    pub fn strong_count(self) -> u64 { unsafe { atomic_load(&self.pointer.references) } }

    pub fn upgrade(self) -> Option(Shared(T)) {
        unsafe {
            loop {
                let count = atomic_load(&self.pointer.references)
                if count == 0 { return None }
                if count >= 0x7fffffffffffffff { panic("shared reference overflow") }
                if atomic_cas(&self.pointer.references, count, count + 1) { return Some(Shared(T) { pointer: self.pointer }) }
            }
        }
    }

    pub fn address(self) -> u64 { unsafe { &self.pointer.value as u64 } }
}

impl(T: type) Clone for Weak(T) {
    fn clone(self) -> Weak(T) {
        unsafe {
            if atomic_add(&self.pointer.weak, 1) >= 0x7fffffffffffffff { panic("weak reference overflow") }
            Weak(T) { pointer: self.pointer }
        }
    }
}

impl(T: type) Drop for Weak(T) {
    fn drop(inout self) {
        unsafe { if atomic_sub(&self.pointer.weak, 1) == 1 { mem.dealloc(Inner(T), self.pointer, 1) } }
    }
}
