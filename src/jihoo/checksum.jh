fn checksum(bytes: [u8], initial: u32) -> u16 {
    var sum = initial
    var i = 0
    while i + 1 < bytes.len {
        sum += ((bytes[i] as u32) << 8) | (bytes[i + 1] as u32)
        i += 2
    }
    if i < bytes.len { sum += (bytes[i] as u32) << 8 }
    while sum >> 16 != 0 { sum = (sum & 0xffff) + (sum >> 16) }
    !(sum as u16)
}

pub export fn jihoo_checksum(data: *u8, length: u64) -> u16 {
    checksum(unsafe { make_slice(data, length as i64) }, 0)
}

pub export fn jihoo_transport_checksum(src: u32, dst: u32, protocol: u8, data: *u8, length: u64) -> u16 {
    var sum: u32 = 0
    for address in [src, dst] {
        sum += ((address & 0xff) << 8) | ((address >> 8) & 0xff)
        sum += (((address >> 16) & 0xff) << 8) | (address >> 24)
    }
    sum += protocol as u32 + length as u32
    checksum(unsafe { make_slice(data, length as i64) }, sum)
}
