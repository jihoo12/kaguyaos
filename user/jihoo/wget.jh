#![freestanding]

import kaguya as os

const MAX_URL: i64 = 512
const HEADER_CAP: i64 = 4096

fn eprint(text: str) { os.write_fd(os.STDERR, text) }

fn eprint_number(value: u64) {
    var bytes: [u8; 20] = [0; 20]
    var n = value
    var i = 20
    loop {
        i -= 1
        bytes[i] = '0' + (n % 10) as u8
        n /= 10
        if n == 0 { break }
    }
    unsafe { eprint(make_str(&bytes[i], 20 - i)) }
}

fn fail(message: str) -> never {
    eprint("wget: ")
    eprint(message)
    eprint("\n")
    os.exit(1)
}

struct Url {
    host: str
    port: u16
    target: str
}

struct UrlBuf {
    bytes: [u8; 512]
    len: i64
}

fn valid_utf8(text: str) -> bool {
    var i = 0
    while i < text.len {
        let lead = text[i]
        if lead < 128 { i += 1; continue }
        let count = if lead >= 0xc2 && lead <= 0xdf { 2 }
            else if lead >= 0xe0 && lead <= 0xef { 3 }
            else if lead >= 0xf0 && lead <= 0xf4 { 4 }
            else { return false }
        if i + count > text.len { return false }
        let second = text[i + 1]
        if (lead == 0xe0 && second < 0xa0) || (lead == 0xed && second > 0x9f) ||
            (lead == 0xf0 && second < 0x90) || (lead == 0xf4 && second > 0x8f) {
            return false
        }
        for j in 1..count {
            if text[i + j] < 0x80 || text[i + j] > 0xbf { return false }
        }
        i += count
    }
    true
}

impl UrlBuf {
    fn new() -> UrlBuf { UrlBuf { bytes: [0; 512], len: 0 } }

    fn push(inout self, text: str) {
        if self.len + text.len > MAX_URL { fail("URL too long") }
        for byte in text {
            self.bytes[self.len] = byte
            self.len += 1
        }
    }

    fn as_str(self) -> str {
        let text = unsafe { make_str(&self.bytes[0], self.len) }
        if !valid_utf8(text) { fail("URL is not UTF-8") }
        text
    }
}

fn parse_number(text: str) -> Option(u64) {
    if text.len == 0 { return None }
    var value: u64 = 0
    for byte in text {
        if byte < '0' || byte > '9' { return None }
        let digit = (byte - '0') as u64
        if value > (0xffffffffffffffff - digit) / 10 { return None }
        value = value * 10 + digit
    }
    Some(value)
}

fn parse_url(url: str) -> Result(Url, str) {
    var rest = url
    if url.starts_with("http://") {
        rest = url[7..url.len]
    } else if url.starts_with("https://") {
        return Err("https is not supported")
    } else if url.contains("://") {
        return Err("only http:// URLs are supported")
    }
    rest = rest[0..rest.find("#").unwrap_or(rest.len)]
    var end = rest.len
    for i in 0..rest.len {
        if rest[i] == '/' || rest[i] == '?' { end = i; break }
    }
    let authority = rest[0..end]
    let target = rest[end..rest.len]
    var colon = -1
    for i in 0..authority.len {
        if authority[i] == ':' { colon = i }
    }
    var host = authority
    var port: u16 = 80
    if colon >= 0 {
        host = authority[0..colon]
        let value = match parse_number(authority[colon + 1..authority.len]) {
            Some(n) => n
            None => return Err("bad port")
        }
        if value > 65535 { return Err("bad port") }
        port = value as u16
    }
    if host.len == 0 || port == 0 { return Err("missing host") }
    Ok(Url { host, port, target })
}

fn port_suffix(inout buffer: [u8; 6], port: u16) -> str {
    if port == 80 { return "" }
    var i = 6
    var value = port
    loop {
        i -= 1
        buffer[i] = '0' + (value % 10) as u8
        value /= 10
        if value == 0 { break }
    }
    i -= 1
    buffer[i] = ':'
    unsafe { make_str(&buffer[i], 6 - i) }
}

fn push_normalized_path(inout out: UrlBuf, path: str) {
    var segments: [str; 64] = [""; 64]
    var count = 0
    var directory = false
    let text = if path.starts_with("/") { path[1..path.len] } else { path }
    var start = 0
    for end in 0..text.len + 1 {
        if end < text.len && text[end] != '/' { continue }
        let part = text[start..end]
        directory = part == "." || part == ".."
        if part == ".." {
            if count > 0 { count -= 1 }
        } else if part != "." {
            if count == 64 { fail("URL has too many path segments") }
            segments[count] = part
            count += 1
        }
        start = end + 1
    }
    out.push("/")
    for i in 0..count {
        if i > 0 { out.push("/") }
        out.push(segments[i])
    }
    if directory && count > 0 { out.push("/") }
}

fn alpha(byte: u8) -> bool {
    (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z')
}

fn has_scheme(text: str) -> bool {
    if text.len == 0 || !alpha(text[0]) { return false }
    for byte in text {
        if byte == ':' { return true }
        if !alpha(byte) && !(byte >= '0' && byte <= '9') &&
            byte != '+' && byte != '-' && byte != '.' { return false }
    }
    false
}

fn resolve(base: Url, location: str) -> UrlBuf {
    var out = UrlBuf.new()
    if has_scheme(location) { out.push(location); return out }
    if location.starts_with("//") {
        out.push("http:")
        out.push(location)
        return out
    }
    var port: [u8; 6] = [0; 6]
    out.push("http://")
    out.push(base.host)
    out.push(port_suffix(&port, base.port))
    var base_path = base.target[0..base.target.find("?").unwrap_or(base.target.len)]
    if !base_path.starts_with("/") { base_path = "/" }
    let target = location[0..location.find("#").unwrap_or(location.len)]
    var merged = UrlBuf.new()
    if target.len == 0 {
        merged.push(if base.target.len == 0 { "/" } else { base.target })
    } else if target.starts_with("/") {
        merged.push(target)
    } else if target.starts_with("?") {
        merged.push(base_path)
        merged.push(target)
    } else {
        var dir = 0
        for i in 0..base_path.len { if base_path[i] == '/' { dir = i + 1 } }
        merged.push(base_path[0..dir])
        merged.push(target)
    }
    let text = merged.as_str()
    let query = text.find("?").unwrap_or(text.len)
    push_normalized_path(&out, text[0..query])
    out.push(text[query..text.len])
    out
}

fn write_all(fd: i64, data: [u8]) -> bool {
    var done = 0
    while done < data.len {
        let n = os.call(31, fd, &data[done] as i64, data.len - done, 0, 0)
        if n <= 0 { return false }
        done += n
    }
    true
}

fn lower(byte: u8) -> u8 {
    if byte >= 'A' && byte <= 'Z' { byte + 32 } else { byte }
}

fn header(headers: str, name: str) -> Option(str) {
    var start = headers.find("\n").unwrap_or(headers.len) + 1
    while start < headers.len {
        var end = start
        while end < headers.len && headers[end] != '\n' { end += 1 }
        var line = headers[start..end]
        if line.ends_with("\r") { line = line[0..line.len - 1] }
        match line.find(":") {
            Some(colon) => if colon == name.len {
                var same = true
                for i in 0..colon {
                    if lower(line[i]) != lower(name[i]) { same = false }
                }
                if same { return Some(line[colon + 1..line.len].trim()) }
            }
            None => {}
        }
        start = end + 1
    }
    None
}

enum Outcome { Done(bool), Redirect(i64) }

fn fetch(url: Url, inout next: [u8; 512]) -> Outcome {
    let ip = match os.parse_ip(url.host) {
        Some(ip) => ip
        None => match os.dns_resolve(url.host) {
            Some(ip) => ip
            None => fail("cannot resolve host")
        }
    }
    eprint("Connecting to ")
    eprint(url.host)
    eprint(":")
    eprint_number(url.port as u64)
    eprint("...\n")
    let fd = os.call(37, 2, 0, 0, 0, 0)
    if fd < 0 { fail("cannot create socket") }
    match os.call(39, fd, os.pack_ip(ip), url.port as i64, 0, 0) {
        0 => {}
        -14 => fail("connection refused")
        -11 => fail("connection timed out")
        _ => fail("cannot connect")
    }
    var port: [u8; 6] = [0; 6]
    let slash = if url.target.starts_with("/") { "" } else { "/" }
    let parts = ["GET ", slash, url.target, " HTTP/1.0\r\nHost: ", url.host,
        port_suffix(&port, url.port),
        "\r\nUser-Agent: kaguyaOS-wget\r\nAccept: */*\r\nConnection: close\r\n\r\n"]
    for part in parts {
        if !write_all(fd, part.as_bytes()) { fail("cannot send request") }
    }
    var bytes: [u8; 4096] = [0; 4096]
    var len = 0
    var header_end = 0
    loop {
        let current = unsafe { make_str(&bytes[0], len) }
        match current.find("\r\n\r\n") {
            Some(i) => { header_end = i + 4; break }
            None => {}
        }
        if len == HEADER_CAP { fail("response headers too long") }
        let n = unsafe { os.read_fd(fd, &bytes[len], HEADER_CAP - len) }
        if n <= 0 { fail("connection closed before the response headers") }
        len += n
    }
    let headers = unsafe { make_str(&bytes[0], header_end) }
    let status_line = headers[0..headers.find("\r").unwrap_or(headers.len)]
    let space = status_line.find(" ").unwrap_or(status_line.len)
    var end = space + 1
    while end < status_line.len && status_line[end] != ' ' { end += 1 }
    if space >= status_line.len { fail("malformed status line") }
    let status = match parse_number(status_line[space + 1..end]) {
        Some(value) => value
        None => fail("malformed status line")
    }
    eprint("HTTP ")
    if status_line.len >= 9 { eprint(status_line[9..status_line.len]) }
    eprint("\n")
    if status >= 300 && status < 400 {
        match header(headers, "Location") {
            Some(location) => {
                if location.len > MAX_URL { fail("redirect target too long") }
                for i in 0..location.len { next[i] = location[i] }
                os.close(fd)
                return Outcome.Redirect(location.len)
            }
            None => {}
        }
    }
    let expected = match header(headers, "Content-Length") {
        Some(value) => parse_number(value)
        None => None
    }
    var total = (len - header_end) as u64
    let body = unsafe { make_slice(&bytes[0], len) }
    if !write_all(os.STDOUT, body[header_end..len]) { fail("cannot write output") }
    loop {
        let n = unsafe { os.read_fd(fd, &bytes[0], HEADER_CAP) }
        if n < 0 { fail("connection reset") }
        if n == 0 { break }
        if !write_all(os.STDOUT, unsafe { make_slice(&bytes[0], n) }) {
            fail("cannot write output")
        }
        total += n as u64
    }
    os.close(fd)
    eprint_number(total)
    eprint(" bytes received\n")
    match expected {
        Some(value) => if value != total { fail("body shorter than Content-Length") }
        None => {}
    }
    Outcome.Done(status >= 200 && status < 300)
}

export fn kaguya_main(args: *u8, length: i64) -> never {
    let text = unsafe { make_str(args, length) }
    if !valid_utf8(text) { fail("arguments are not UTF-8") }
    let arg = text.trim()
    if arg.len == 0 || arg.contains(" ") || arg.len > MAX_URL {
        eprint("Usage: wget [http://]host[:port][/path]\n")
        os.exit(1)
    }
    var current = UrlBuf.new()
    current.push(arg)
    for redirects in 0..6 {
        let url = match parse_url(current.as_str()) {
            Ok(url) => url
            Err(message) => fail(message)
        }
        var next: [u8; 512] = [0; 512]
        match fetch(url, &next) {
            Done(ok) => os.exit(if ok { 0 } else { 1 })
            Redirect(len) => {
                let location = unsafe { make_str(&next[0], len) }
                let target = resolve(url, location)
                current = target
                eprint("Redirected to ")
                eprint(current.as_str())
                eprint("\n")
            }
        }
    }
    fail("too many redirects")
}
