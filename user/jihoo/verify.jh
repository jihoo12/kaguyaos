#![freestanding]

import kaguya as os

static THREAD_STACK: [u64; 2048] = [0; 2048]
static THREAD_VALUE: u64 = 0
static THREAD_FD: i64 = -1

fn compatibility_thread() -> never {
    require(os.write_fd(unsafe { THREAD_FD }, "thread") == 6, 70)
    unsafe { atomic_store(&THREAD_VALUE, 123) }
    os.exit(71)
}

fn require(condition: bool, code: i64) {
    if !condition { os.exit(code) }
}

export fn kaguya_main(arguments: *u8, count: i64) -> never {
    let args = unsafe { make_str(arguments, count) }
    if args == "compat-child" { os.exit(72) }
    if args == "compat" {
        let name = "abi-test"
        let data = "legacy"
        require(os.call(13, name.ptr as i64, name.len, data.ptr as i64, data.len, 0) == 0, 60)
        require(os.call(14, name.ptr as i64, name.len, 0, 0, 0) == 6, 61)
        var buffer: [u8; 6] = [0; 6]
        require(os.call(14, name.ptr as i64, name.len, &buffer[0] as i64, 6, 0) == 6, 62)
        require(unsafe { make_str(&buffer[0], 6) } == data, 63)
        require(os.call(14, name.ptr as i64, name.len, 4096, 6, 0) == -2, 64)
        require(os.call(3, 4096, 4096, 0, 0, 0) == -1, 65)
        let fd = os.open(name, os.O_READ | os.O_WRITE | os.O_TRUNC)
        require(fd >= 3, 66)
        unsafe { THREAD_FD = fd }
        let entry: fnptr() -> never = compatibility_thread
        let top = unsafe { ((&THREAD_STACK[0] as u64 + 16384) & !15) - 8 }
        let thread = os.call(3, entry as i64, top as i64, 0, 0, 0)
        require(thread > 0 && os.call(26, thread, 0, 0, 0, 0) == 71, 67)
        require(unsafe { atomic_load(&THREAD_VALUE) } == 123, 68)
        require(os.call(33, fd, 0, 0, 0, 0) == 0, 69)
        require(unsafe { os.read_fd(fd, &buffer[0], 6) } == 6 && unsafe { make_str(&buffer[0], 6) } == "thread", 73)
        os.close(fd)
        require(os.call(15, name.ptr as i64, name.len, 0, 0, 0) == 0, 74)
        let program = "verify.kef"
        let child_args = "compat-child"
        let child = os.call(22, program.ptr as i64, program.len, child_args.ptr as i64, child_args.len, 0)
        require(child > 0 && os.call(26, child, 0, 0, 0, 0) == 72, 75)
        let utility = "ls.kef"
        let listing = os.call(21, utility.ptr as i64, utility.len, 0, 0, 0)
        require(listing > 0 && os.call(26, listing, 0, 0, 0, 0) == 0, 76)
        require(os.call(6, 0, 0, 0, 0, 0) == 0, 77)
        let message = "Compatibility: legacy files, exec and shared-address-space threads passed\n"
        os.call(0, message.ptr as i64, message.len, 0, 0, 0)
        var cells: [u32; 9] = ['A' as u32, 0xffffff, 0x1234ab, 'B' as u32, 0xffffff, 0x2345bc, 'I' as u32, 0xffffff, 0x3456cd]
        os.call(20, 2, 0, &cells[0] as i64, 3, 2)
        os.exit(0)
    }
    if args == "busy" {
        let start = os.milliseconds()
        while os.milliseconds() - start < 300 {}
        os.exit(0)
    }
    if args == "preemption" {
        let first = os.spawn("verify.kef", "busy", [0, 1, 2])
        let second = os.spawn("verify.kef", "busy", [0, 1, 2])
        require(first > 0 && second > 0, 50)
        require(os.call(26, first, 0, 0, 0, 0) == 0, 51)
        require(os.call(26, second, 0, 0, 0, 0) == 0, 52)
        os.exit(0)
    }
    if args == "producer" {
        var buffer: [u8; 6000] = [0; 6000]
        for i in 0..6000 { buffer[i] = (i % 251) as u8 }
        require(os.call(31, 1, &buffer[0] as i64, 6000, 0, 0) == 6000, 40)
        os.exit(0)
    }
    if args == "consumer" {
        var buffer: [u8; 500] = [0; 500]
        var received: i64 = 0
        loop {
            let n = unsafe { os.read_fd(0, &buffer[0], 500) }
            require(n >= 0 && received + n <= 6000, 41)
            if n == 0 { break }
            for i in 0..n { require(buffer[i] == ((received + i) % 251) as u8, 42) }
            received += n
        }
        require(received == 6000, 43)
        os.exit(0)
    }
    if args == "scheduler" {
        require(os.call(34, 4096, 0, 0, 0, 0) == -2, 30)
        require(os.spawn("verify.kef", "", [999, 1, 2]) == -1, 31)
        let fd = os.open("scheduled", os.O_READ | os.O_WRITE | os.O_CREATE | os.O_TRUNC)
        require(fd >= 3, 32)
        require(os.write_fd(fd, "saved") == 5, 33)
        require(os.call(33, fd, 0, 0, 0, 0) == 0, 34)
        var data: [u8; 5] = [0; 5]
        require(unsafe { os.read_fd(fd, &data[0], 5) } == 5, 35)
        require(unsafe { make_str(&data[0], 5) } == "saved", 36)
        os.close(fd)
        let (reader, writer) = match os.pipe() { Some(pair) => pair, None => os.exit(37) }
        let producer = os.spawn("verify.kef", "producer", [0, writer, 2])
        let consumer = os.spawn("verify.kef", "consumer", [reader, 1, 2])
        require(producer > 0 && consumer > 0, 38)
        os.close(reader)
        os.close(writer)
        require(os.call(26, producer, 0, 0, 0, 0) == 0, 44)
        require(os.call(26, consumer, 0, 0, 0, 0) == 0, 45)
        require(os.call(25, 21, 0, 0, 0, 0) == 0, 46)
        os.exit(0)
    }
    if args == "fault" {
        unsafe { write_volatile(4096 as *u8, 1) }
        os.exit(99)
    }
    if args == "nx" {
        let heap = os.call(28, 1, 0, 0, 0, 0)
        require(heap != 0, 20)
        unsafe {
            write_volatile(heap as *u8, 0xc3)
            let function = heap as fnptr() -> u64
            function()
        }
        os.exit(99)
    }
    if args == "timer" {
        let start = os.milliseconds()
        while os.milliseconds() - start < 100 {}
        os.exit(0)
    }
    require(args == "syscall probe", 1)
    require(os.call(31, 1, 0, 1, 0, 0) == -2, 2)
    require(os.call(31, 1, 4096, 1, 0, 0) == -2, 3)
    require(os.call(31, 1, 0x7ffffffebfff, 2, 0, 0) == -2, 4)
    require(os.call(31, 1, -16, 32, 0, 0) == -2, 5)
    require(os.call(31, 1, 0, 0, 0, 0) == 0, 6)
    let message = "jihoo ring3 syscall probe\n"
    require(os.write_fd(os.STDOUT, message) == message.len, 7)
    let heap = os.call(28, 1, 0, 0, 0, 0)
    require(heap == 0x700000000000, 8)
    unsafe {
        let bytes = heap as *u8
        for i in 0..4096 { require(bytes[i] == 0, 9) }
        bytes[0] = 0x12
        bytes[4095] = 0x34
        require(bytes[0] == 0x12 && bytes[4095] == 0x34, 10)
    }
    require(os.call(28, 0x10000001, 0, 0, 0, 0) == 0, 11)
    require(os.call(28, 0, 0, 0, 0, 0) == heap + 4096, 12)
    os.exit(0)
}
